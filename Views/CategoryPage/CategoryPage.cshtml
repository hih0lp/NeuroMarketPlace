    <script>
        // Избранное для первого блока
        const favoriteBtns1 = document.querySelectorAll('.favorite-btn_N23');
        favoriteBtns1.forEach(btn => {
            btn.addEventListener('click', () => {
                btn.classList.toggle('active');
            });
        });
 
        // Корзина для первого блока
        const addToCartBtns1 = document.querySelectorAll('.add-to-cart_N23');
        addToCartBtns1.forEach(btn => {
            btn.addEventListener('click', () => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<strong>Добавлено!</strong>';
                btn.style.backgroundColor = '#2ecc71';
                setTimeout(() => {
                    btn.innerHTML = originalText;
                    btn.style.backgroundColor = 'rgb(231, 255, 93)';
                }, 2000);
            });
        });
 
        // Избранное для второго блока
        const favoriteBtns2 = document.querySelectorAll('.favorite-btn_cards_3');
        favoriteBtns2.forEach(btn => {
