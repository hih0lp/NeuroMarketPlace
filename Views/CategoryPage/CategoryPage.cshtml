<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Адаптивная шапка сайта</title>
    <link rel="stylesheet" href="../styles/CategoryPageStyle.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&family=Goldman:wght@400;700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
      integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <header class="header">
      <a href="#" class="logo">
        <img src="../images/Estate_House.svg" alt="Логотип" />
      </a>

      <div class="search-wrapper">
        <div class="search-container">
          <button class="search-button" aria-label="Поиск">
            <i class="fas fa-search"></i>
          </button>
          <input type="text" class="search-input" placeholder="Поиск..." />
        </div>
      </div>

      <nav class="links">
        <a href="#">Сравнение</a>
        <a href="#">Профиль</a>
      </nav>
    </header>

    <main>
      <div class="content-wrapper2">
        <div class="logo-container2">
          <img src="../images/Frame 2.svg" alt="Логотип" />
        </div>
        <p class="catalog-text2">Каталог мебели</p>
      </div>
    </main>

    <div class='container2' id="category-container">
      <div class="item" id="example">
        <div class="ded" class="category-name">
          Для <br />
          детской
        </div class="category-template category-item">
        <img src="../images/детдом.svg" alt="Image 1" />
      </div>
      <!-- здесь был Никита-->
    </div>

    <!-- ху№ню ниже написал Азат -->
    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', () => {

        const categoryContainer = document.getElementById('category-container');
        const categoryTemplate = document.querySelector('.category-template');

        if (!categoryContainer || !categoryTemplate) {
          console.error("Не найден контейнер категорий или шаблон категории!");
          return;
        }

        async function fetchCategories() {
          try {
            const response = await fetch('CategoryPage/GetCategories');
            if (!response.ok) {
              throw new Error(`HTTP error! Status: ${response.status}`);
            }
            const categories = await response.json();
            return categories;
          } catch (error) {
            console.error("Ошибка при загрузке категорий:", error);
            return [];
          }
        }

        async function createCategoryElement(category) {
          const categoryDiv = categoryTemplate.cloneNode(true);
          categoryDiv.classList.remove('category-template');
          categoryDiv.style.display = '';

          const categoryImage = categoryDiv.querySelector('.category-image');
          const categoryName = categoryDiv.querySelector('.category-name');

          if (!categoryImage || !categoryName) {
            console.error("Не найден элемент изображения или имени категории в шаблоне!");
            return null;
          }

          categoryImage.src = category.pictureUrl;
          categoryImage.alt = category.name;
          categoryName.textContent = category.name;

          return categoryDiv;
        }


        async function displayCategories() {
          const categories = await fetchCategories();

          if (categories.length === 0) {
            console.warn("Нет категорий для отображения.");
            return;
          }

          for (const category of categories) {
            const categoryElement = await createCategoryElement(category);

            if (categoryElement) {
              categoryContainer.appendChild(categoryElement);
            }
          }
        }

        displayCategories();
      });
    </script>
  </body>
</html>
